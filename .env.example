# CUTI-Tools configuration. Copy to .env and edit; every value below is optional
# (the shown value is the built-in default). Real environment variables win over
# this file. Unknown CUTI_* variables are rejected at startup.

# ---------- storage ----------
CUTI_DB_PATH=var/auctions.db
CUTI_RULES_PATH=config/rules.json

# ---------- sources ----------
# Local path, file:// or http(s):// all work. Point these at production URLs
# to run against the real market; the sample fixtures keep the MVP runnable offline.
CUTI_LOTS_SOURCE_URL=data/sample/catawiki/page-1.html
CUTI_DEALS_SOURCE_URL=data/sample/deals/deals.json
CUTI_SOURCE_MAX_PAGES=10
CUTI_HTTP_TIMEOUT_SECONDS=20
CUTI_RESPONSE_MAX_BYTES=5000000

# ---------- live auction capture ----------
# The auction site cannot be searched for closed lots, so ids are captured while
# bidding is open (`watch-live`) and the hammer price is read after it ends
# (`settle`). Only these two commands touch the JSON endpoints.
CUTI_CATAWIKI_API_BASE=https://www.catawiki.com
# Comma-separated search queries; each one is paged until a page comes back empty.
CUTI_CATAWIKI_QUERIES=watch
CUTI_CATAWIKI_SEARCH_MAX_PAGES=5
# Ids per live-state request (1..100) and pause between requests. Keep the pause
# at 1s or higher: this is an unofficial endpoint, politeness is the rate limit.
CUTI_CATAWIKI_BATCH_SIZE=50
CUTI_CATAWIKI_PAUSE_SECONDS=1.0
# Public lot Details are opt-in. When enabled, requests are delayed and
# temporary timeout/429/5xx failures are retried with exponential backoff.
CUTI_DETAILS_ENABLED=false
CUTI_DETAILS_REQUEST_DELAY_SECONDS=1.0
CUTI_DETAILS_MAX_RETRIES=2
# Work caps per run, so a cron job has a predictable cost.
CUTI_SETTLE_MAX_LOTS=200
CUTI_URL_CHECK_MAX_LOTS=200

# ---------- pricing ----------
# net = hammer - hammer*commission*(1+vat) - shipping - cost
CUTI_COMMISSION_RATE=0.125
CUTI_VAT_ON_COMMISSION_RATE=0.21
CUTI_SHIPPING_EUR=35
CUTI_EUR_VND_RATE=27000
# Buy only if profit clears max(cost * margin, absolute floor).
CUTI_MIN_MARGIN_RATE=0.15
CUTI_MIN_PROFIT_EUR=50

# ---------- comparables ----------
CUTI_MIN_COMPARABLES=5
CUTI_MATCH_THRESHOLD=0.85
CUTI_COMPARABLE_WINDOW_DAYS=730

# ---------- liquidity index ----------
CUTI_LIQUIDITY_REF_DAYS=30
CUTI_LIQUIDITY_HOT_HEARTS=50
CUTI_LIQUIDITY_W_SELL_THROUGH=0.5
CUTI_LIQUIDITY_W_SPEED=0.3
CUTI_LIQUIDITY_W_HEARTS=0.2
CUTI_LIQUIDITY_MIN_LOTS=5
CUTI_LIQUIDITY_DECLINE_RATE=0.20

# ---------- deal freshness ----------
CUTI_DEAL_MAX_AGE_DAYS=30
CUTI_ALERT_MAX_ATTEMPTS=8

# ---------- notifications ----------
# file = append alerts to JSONL (default, no network); telegram = Bot API.
CUTI_NOTIFIER=file
CUTI_NOTIFIER_FILE_PATH=var/alerts.jsonl
CUTI_TELEGRAM_API_BASE=https://api.telegram.org
CUTI_TELEGRAM_BOT_TOKEN=
CUTI_TELEGRAM_CHAT_ID=

# ---------- reporting ----------
CUTI_REPORT_PATH=var/report.html
