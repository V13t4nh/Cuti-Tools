{
  "name": "cuti-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "python ../scripts/run_frontend.py dev",
    "dev:ui": "vite --host 127.0.0.1",
    "preview": "python ../scripts/run_frontend.py preview",
    "preview:ui": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "gsap": "^3.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
