{
  "schemaVersion": 1,
  "project": "cuti-tools",
  "language": "python",
  "runtime": {
    "name": "python",
    "major": 3,
    "platform": "linux",
    "architecture": "x64",
    "glibc": "AL2023-compatible"
  },
  "verification": {
    "command": "PYTHONPATH=src python -m unittest discover -s tests -v",
    "testReady": true,
    "sourceOnlyTestReady": true,
    "dependencyBundleRequired": false,
    "status": "green",
    "blockingReason": null,
    "network": "disabled",
    "docker": "unsupported",
    "database": "unsupported"
  },
  "packaging": {
    "sourceOnlyDefault": true,
    "dependencyBundleManifest": "dependency-manifest.json",
    "dependencyBundlePrefix": "dependencies/",
    "patchCommand": "git diff --binary > changes.patch"
  }
}
