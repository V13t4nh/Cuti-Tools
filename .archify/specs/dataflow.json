  "flows": [
    { "id": "f_cw_pipeline", "from": "cw_api", "to": "pipeline", "label": "open lots", "classification": "crawler batch", "variant": "emphasis", "route": "straight" },
    { "id": "f_deals_ingest", "from": "deals_feed", "to": "deals_ingest", "label": "raw asks", "classification": "feed stream", "variant": "default", "route": "straight" },

    { "id": "f_pipeline_live", "from": "pipeline", "to": "live_q", "label": "queue open", "classification": "queue insert", "variant": "default", "route": "straight" },
    { "id": "f_pipeline_settle", "from": "pipeline", "to": "lots_db", "label": "settled hammer", "classification": "hammer record", "variant": "emphasis", "fromSide": "right", "toSide": "left" },
    { "id": "f_ingest_deals", "from": "deals_ingest", "to": "deals_db", "label": "deduped deals", "classification": "deal record", "variant": "default", "route": "straight" },

    { "id": "f_lots_liquidity", "from": "lots_db", "to": "liquidity_engine", "label": "attempts & sell-through", "classification": "market pool", "variant": "default", "route": "straight" },
    { "id": "f_lots_pricing", "from": "lots_db", "to": "pricing_engine", "label": "sold comparables", "classification": "comps pool", "variant": "emphasis", "fromSide": "right", "toSide": "left" },
    { "id": "f_deals_pricing", "from": "deals_db", "to": "pricing_engine", "label": "asking prices", "classification": "quote input", "variant": "default", "route": "straight" },

    { "id": "f_liquidity_terminal", "from": "liquidity_engine", "to": "terminal", "label": "segment metrics", "classification": "health index", "variant": "default", "route": "straight" },
    { "id": "f_pricing_terminal", "from": "pricing_engine", "to": "terminal", "label": "verdict & max buy", "classification": "valuation signal", "variant": "emphasis", "fromSide": "top", "toSide": "bottom" },
    { "id": "f_pricing_outbox", "from": "pricing_engine", "to": "outbox", "label": "green deal alert", "classification": "notification", "variant": "security", "route": "straight" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "2-Phase Ingestion",
      "items": [
        "Open lots are queued during bidding into live_watch table",
        "Settlement pipeline extracts hammer price, bids, and hearts at close",
        "Synthetic test data is strictly segregated from real valuation pools"
      ]
    },
    {
      "dot": "cyan",
      "title": "Reliable Delivery",
      "items": [
        "Valuation decisions stream directly to the React 19 terminal",
        "Profitable Green alerts write transactionally into the alert outbox",
        "Outbox retries delivery to Telegram with dead-letter protection"
      ]
    }
  ]
