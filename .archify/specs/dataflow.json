    { "id": "deals_db", "type": "database", "label": "deals table", "sublabel": "tracked deals", "stage": 2, "row": 2, "tag": "storage" },

    { "id": "liquidity_engine", "type": "backend", "label": "Liquidity Engine", "sublabel": "Brand + Form", "stage": 3, "row": 1, "tag": "velocity" },
