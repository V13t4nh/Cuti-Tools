    { "id": "terminal", "type": "frontend", "label": "React Terminal", "sublabel": "decision UI", "stage": 4, "row": 1, "tag": "interactive" },
    { "id": "outbox", "type": "messagebus", "label": "Alert Outbox", "sublabel": "Telegram outbox", "stage": 4, "row": 2, "tag": "delivery" }
